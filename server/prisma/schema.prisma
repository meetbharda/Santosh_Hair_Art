datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  role         Role                 @default(CUSTOMER)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  profile      CustomerProfile?
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  auditLogs    AuditLog[]
  bookings     Booking[]

  @@map("users")
}

model CustomerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  fullName    String
  phoneNumber String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model ServiceCategory {
  id           String    @id @default(uuid())
  name         String    @unique
  description  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  services     Service[]

  @@map("service_categories")
}

model Service {
  id              String            @id @default(uuid())
  categoryId      String
  name            String
  description     String?
  pricePaise      Int // Stored in paise (e.g. ₹150.00 = 15000)
  durationMinutes Int // e.g. 30
  bufferMinutes   Int               @default(5)
  imageUrl        String?
  isActive        Boolean           @default(true)
  displayOrder    Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  category        ServiceCategory   @relation(fields: [categoryId], references: [id])
  bookingServices BookingService[]

  @@map("services")
}

model Booking {
  id                   String           @id @default(uuid())
  bookingReference     String           @unique // e.g. SHA-829102
  userId               String? // Optional for guest bookings or linked to logged-in user
  customerName         String
  customerPhone        String
  customerEmail        String?
  notes                String?
  totalPricePaise      Int
  totalDurationMinutes Int
  startTime            DateTime
  endTime              DateTime
  status               BookingStatus    @default(CONFIRMED)
  cancellationReason   String?
  internalNotes        String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingServices      BookingService[]

  @@index([startTime, endTime])
  @@index([status])
  @@map("bookings")
}

model BookingService {
  id              String   @id @default(uuid())
  bookingId       String
  serviceId       String?
  serviceName     String // Snapshot name at booking time
  pricePaise      Int // Snapshot price in paise at booking time
  durationMinutes Int // Snapshot duration at booking time
  createdAt       DateTime @default(now())
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service         Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("booking_services")
}

model BusinessSettings {
  id                    String   @id @default("default")
  businessName          String   @default("Santosh Hair Art")
  tagline               String   @default("Master Barbering & Grooming Studio")
  phoneNumber           String   @default("+91 95378 51649")
  whatsappNumber        String   @default("+91 95378 51649")
  email                 String   @default("contact@santoshhairart.in")
  address               String   @default("Near ST Bus Station, Chock, Gaffar Belim, Mangrol, Gujarat 362225, India")
  googleMapsUrl         String   @default("https://maps.app.goo.gl/1NHaQgexgWuvfmq16")
  latitude              Float    @default(21.1889284)
  longitude             Float    @default(70.0476545)
  timezone              String   @default("Asia/Kolkata")
  slotIntervalMinutes   Int      @default(30)
  leadTimeHours         Int      @default(1)
  maxAdvanceDays        Int      @default(30)
  cancellationCutoffHrs Int      @default(2)
  bufferTimeMinutes     Int      @default(5)
  currency              String   @default("INR")
  isAutoConfirm         Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("business_settings")
}

model BusinessHour {
  id         String          @id @default(uuid())
  dayOfWeek  Int             @unique // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  isClosed   Boolean         @default(false)
  openTime   String          @default("09:00") // HH:mm format
  closeTime  String          @default("21:00")
  breaks     BusinessBreak[]

  @@map("business_hours")
}

model BusinessBreak {
  id             String       @id @default(uuid())
  businessHourId String
  name           String       @default("Lunch Break")
  startTime      String       @default("13:30")
  endTime        String       @default("14:30")
  businessHour   BusinessHour @relation(fields: [businessHourId], references: [id], onDelete: Cascade)

  @@map("business_breaks")
}

model BlockedPeriod {
  id            String   @id @default(uuid())
  title         String
  reason        String?
  startDateTime DateTime
  endDateTime   DateTime
  isAllDay      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([startDateTime, endDateTime])
  @@map("blocked_periods")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Enquiry {
  id        String   @id @default(uuid())
  fullName  String
  phone     String
  email     String?
  message   String
  status    String   @default("NEW") // NEW, CONTACTED, RESOLVED
  createdAt DateTime @default(now())

  @@map("enquiries")
}
